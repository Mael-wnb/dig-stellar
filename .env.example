# dig-stellar — ROOT compose environment (Lot Z — T3-D3 reference deployment).
#
# OPTIONAL. docker compose reads a root `.env` for variable substitution in
# docker-compose.yml. Every variable below has a safe public default — the
# reference stack works with NO .env at all:
#   docker compose --profile app up -d --build
#
# (The per-app .env.example files in apps/* belong to the host-pnpm dev path
# and are NOT read by the containers.)

# Short git sha reported as `version` by GET /health ('unknown' when unset):
# GIT_SHA=

# Operator Soroban RPC endpoint. Unset -> public SDF endpoint (rate-limited;
# fine for a first run, get an operator endpoint for a permanent deployment).
# STELLAR_RPC_URL=

# Optional DeFindex API key. Without it the defindex refresh step fails
# NON-fatally each run (recorded in refresh_step_runs); everything else works.
# DEFINDEX_API_KEY=

# Refresh cadence of the containerized indexer loop (seconds).
# REFRESH_INTERVAL_SECONDS=900

# Host port overrides (run a second stack next to a dev one — see the
# docker-compose.yml header; set COMPOSE_PROJECT_NAME too).
# API_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# DIG_CONTAINER_PREFIX=dig_stellar
# COMPOSE_PROJECT_NAME=dig_stellar
