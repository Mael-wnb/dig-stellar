# dig-stellar — ROOT compose environment (Lot Z — T3-D3 reference deployment).
#
# docker compose reads a root `.env` for variable substitution in docker-compose.yml.
# ONE variable is required (POSTGRES_PASSWORD — no default, S1/INV-10.2); everything
# else has a safe public default:
#   cp .env.example .env   # then set POSTGRES_PASSWORD (dev: dig)
#   docker compose --profile app up -d --build
#
# (The per-app .env.example files in apps/* belong to the host-pnpm dev path
# and are NOT read by the containers.)

# Short git sha reported as `version` by GET /health ('unknown' when unset):
# GIT_SHA=

# Operator Soroban RPC endpoint. Unset -> public SDF endpoint (rate-limited;
# fine for a first run, get an operator endpoint for a permanent deployment).
# STELLAR_RPC_URL=

# Optional DeFindex API key. Without it the defindex refresh step fails
# NON-fatally each run (recorded in refresh_step_runs); everything else works.
# DEFINDEX_API_KEY=

# Refresh cadence of the containerized indexer loop (seconds).
# REFRESH_INTERVAL_SECONDS=900

# REQUIRED. Postgres password for the `dig` role. Read by initdb ONLY on an empty
# volume and substituted into the api/indexer DATABASE_URL. Local dev value: dig
# (matches apps/*/.env.example). On a shared host: generated (openssl rand -hex 24),
# rotated in place with ALTER USER, recorded here so a volume re-init matches (S1).
POSTGRES_PASSWORD=dig

# Host port overrides (run a second stack next to a dev one — see the
# docker-compose.yml header; set COMPOSE_PROJECT_NAME too). All bindings are
# 127.0.0.1-only: Docker bypasses ufw; use an SSH tunnel for remote access.
# API_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# DIG_CONTAINER_PREFIX=dig_stellar
# COMPOSE_PROJECT_NAME=dig_stellar
