# apps/web — Vue 3 + Vite frontend (quickstart: docs/reference-deployment.md)
# Copy to .env — the defaults below work against a local apps/api on :3000.

# Base URL of the product API. REQUIRED.
VITE_API_BASE="http://localhost:3000"

# Stellar network the wallet kit targets (PUBLIC | TESTNET).
VITE_STELLAR_NETWORK="PUBLIC"

# Mainnet swap UX gate (T3-D2, Lot A1). UX only — the API kill-switch
# (ACTIONS_MAINNET_ENABLED) is the real enforcement. Unset = testnet-only.
# VITE_ACTIONS_MAINNET_ENABLED="true"

# Mainnet Blend-deposit UX gate (T3-D2, Lot A2). UX only — the API kill-switch
# (ACTIONS_MAINNET_BLEND_ENABLED) is the real enforcement. Unset = testnet-only.
# VITE_ACTIONS_MAINNET_BLEND_ENABLED="true"
