{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../openapi/openapi.v1.yaml",
        "outDir": "dist/openapi",
        "flat": true
      }
    ],
    "watchAssets": true
  }
}
