# apps/api — NestJS product API (quickstart: docs/reference-deployment.md)
# Copy to .env — the defaults below work against the docker-compose stack as-is.

# Postgres connection. REQUIRED. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://dig:dig@localhost:5432/dig_stellar?schema=public"

# HTTP port (default 3000).
PORT=3000

# Comma-separated allowed browser origins (default = the Vite dev server).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Freshness threshold in minutes for stale flags (default 45 = 3x the 15-min cron).
# FRESHNESS_STALE_AFTER_MINUTES=45

# Deploy version stamp reported by GET /health (E1). Export at deploy time:
# GIT_SHA=<short sha from: git rev-parse --short HEAD>

# T3-D2 mainnet action kill-switches. Leave unset for testnet-only (safe default);
# the server enforces these — the VITE_ flags in apps/web are UX only.
# ACTIONS_MAINNET_ENABLED=true
# ACTIONS_MAINNET_BLEND_ENABLED=true
# ACTIONS_MAINNET_MAX_SEND_XLM=100
# ACTIONS_MAINNET_RPC_URL=

# Lot R (reward faucet) — R1 witness. Min XLM-equivalent notional for a witness
# to count toward faucet eligibility (default 1). Stored on each witness row.
# FAUCET_MIN_NOTIONAL_XLM=1

# Lot R — R2 claims + payout (security-invariants.md §9). Defaults deploy DARK.
# FAUCET_ENABLED=false            # kill-switch; founder flips to 'true' to go live
# FAUCET_NETWORK=testnet          # the paying network ('mainnet' at go-live)
# FAUCET_SECRET_KEY=              # VPS ONLY — hot-wallet secret, generated locally
#                                 # by the founder, funded with exactly 200 XLM.
#                                 # NEVER commit a real value here.
# FAUCET_REWARD_XLM=5
# FAUCET_MAX_CLAIMS=40
# FAUCET_HOURLY_CLAIM_CAP=10
