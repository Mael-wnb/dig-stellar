# apps/indexer — ingestion pipeline, runner: tsx (quickstart: docs/reference-deployment.md)
# Copy to .env — the defaults below work for a first `job:refresh` with no secrets.

# Postgres connection. REQUIRED. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://dig:dig@localhost:5432/dig_stellar?schema=public"

# Soroban RPC endpoint. STELLAR_RPC_URL wins over SOROBAN_RPC_URL (lib/rpc-config.ts);
# with BOTH unset the public SDF endpoint is used — rate-limited but fine for a first
# run. Use an operator endpoint (may embed an API key in the path; only hosts are
# ever logged) before putting the 15-min cron in place.
# STELLAR_RPC_URL=
# SOROBAN_RPC_URL=

# Horizon endpoint (defaults to the public one when unset).
HORIZON_URL="https://horizon.stellar.org"

# DeFindex vault refresh (T3-D1). The key is REQUIRED for the defindex step only —
# without it that step fails and is recorded as such (non-fatal: the rest of the
# refresh completes; see refresh_step_runs).
# DEFINDEX_API_KEY=
# DEFINDEX_API_URL="https://api.defindex.io"

# Refresh tuning — job:refresh sets these defaults itself; override only to widen
# an event backfill (e.g. the one-time Aquarius LEDGER_LOOKBACK=115000 pass).
# LEDGER_LOOKBACK=20000
# EVENTS_LIMIT=200
# MAX_EVENT_PAGES=50

# Source account for read-only contract simulations — REQUIRED by the aquarius
# refresh step (any funded mainnet account works; it never signs anything, it is
# only the tx source for simulateTransaction reads). Default = the same public
# account the blend fetcher falls back to.
STELLAR_SOURCE_ACCOUNT="GDCRZPZYBZ24RHRO3WBPJGFDL7NDFKUQBS3ZDB6YGBJB3TGKMFYBQ3LD"

# Discovery/probe script defaults ONLY (discovery/75, discovery/76). The refresh
# pipeline reads its perimeter from the entities table and ignores these.
# BLEND_POOL_ID=
# BLEND_BACKSTOP_ID=
