{
  "name": "@getdig/stellar-mcp",
  "version": "0.1.0",
  "description": "MCP server (stdio) exposing the Dig Stellar public read API as six read-only tools: protocols, pools, network figures, pipeline status",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mael-wnb/dig-stellar.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://stellar-api.getdig.ai/v1/docs",
  "bugs": {
    "url": "https://github.com/Mael-wnb/dig-stellar/issues"
  },
  "keywords": [
    "stellar",
    "defi",
    "soroban",
    "mcp",
    "model-context-protocol",
    "api"
  ],
  "type": "module",
  "bin": {
    "dig-stellar-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "example": "tsx examples/stdio-client.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@getdig/stellar-api": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
